const VERSION = '0.3'; // Code.gs version – bump on every change
/** PTW LMS backend for Google Apps Script.
 * Deploy as Web App: execute as owner. Access setting depends on your risk review.
 * Run setupLms() once, then update Script Properties and create the first admin.
 */
const CFG={
  USERS:'LMS_USERS', OTP:'LMS_OTP', SESSIONS:'LMS_AUTH_SESSIONS', TRAINING:'LMS_TRAINING_SESSIONS',
  PARTICIPANTS:'LMS_PARTICIPANTS', PROGRESS:'LMS_PROGRESS', ATTEMPTS:'LMS_ASSESSMENTS',
  PRACTICAL:'LMS_PRACTICAL', AUDIT:'LMS_AUDIT', COURSE:'LMS_COURSE', MAX_FAILS:5,
  LOCK_MIN:15, OTP_MIN:10, SESSION_HOURS:8, PASS_MARK:80
};
function doGet(){return ContentService.createTextOutput(JSON.stringify({ok:true,service:'PTW LMS API'})).setMimeType(ContentService.MimeType.JSON)}
function doPost(e){try{const x=JSON.parse(e.postData.contents||'{}');const publicActions=['login','requestOtp','verifyOtpSetPassword'];let user=null;if(!publicActions.includes(x.action))user=requireSession_(x.token);const map={login:()=>login_(x),requestOtp:()=>requestOtp_(x),verifyOtpSetPassword:()=>verifyOtpSetPassword_(x),me:()=>({user:safeUser_(user)}),logout:()=>logout_(x.token),dashboard:()=>dashboard_(user),joinSession:()=>joinSession_(user,x),getCourse:()=>getCourse_(user,x),completeModule:()=>completeModule_(user,x),startAssessment:()=>startAssessment_(user,x),submitAssessment:()=>submitAssessment_(user,x),getPractical:()=>getPractical_(user,x),savePractical:()=>savePractical_(user,x),adminSummary:()=>adminSummary_(user),adminCreateUser:()=>adminCreateUser_(user,x)};if(!map[x.action])throw Error('Unknown action');return out_({ok:true,...map[x.action]()})}catch(err){return out_({ok:false,error:'REQUEST_FAILED',message:String(err.message||err)})}}
function out_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
function ss_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw Error('SPREADSHEET_ID is not configured');return SpreadsheetApp.openById(id)}
function sh_(n){let s=ss_().getSheetByName(n);if(!s)throw Error('Missing sheet '+n);return s}
function rows_(n){let v=sh_(n).getDataRange().getValues();if(v.length<2)return[];let h=v.shift();return v.filter(r=>r.some(String)).map(r=>Object.fromEntries(h.map((k,i)=>[k,r[i]])))}
function append_(n,o){let s=sh_(n),h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0];s.appendRow(h.map(k=>o[k]??''))}
function update_(n,key,val,patch){let s=sh_(n),v=s.getDataRange().getValues(),h=v[0],ki=h.indexOf(key);for(let i=1;i<v.length;i++)if(String(v[i][ki])===String(val)){Object.keys(patch).forEach(k=>{let c=h.indexOf(k);if(c>=0)s.getRange(i+1,c+1).setValue(patch[k])});return true}return false}
function id_(p){return p+'-'+Utilities.getUuid().replace(/-/g,'').slice(0,12).toUpperCase()}
function now_(){return new Date().toISOString()}
function norm_(s){return String(s||'').trim().toLowerCase()}
function prop_(k){return PropertiesService.getScriptProperties().getProperty(k)||''}
function hmac_(s){return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(String(s),prop_('PEPPER')))}
function hashPassword_(pw,salt){let v=salt+'|'+pw+'|'+prop_('PEPPER');for(let i=0;i<12000;i++)v=Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,v));return v}
function safeUser_(u){return{userId:u.userId,username:u.username,fullName:u.fullName,email:u.email,role:u.role,status:u.status}}
function findUser_(username,email){return rows_(CFG.USERS).find(u=>norm_(u.username)===norm_(username)&&(!email||norm_(u.email)===norm_(email)))}
function login_(x){let u=findUser_(x.username);if(!u||u.status!=='ACTIVE')throw Error('Invalid username or credentials');if(u.lockUntil&&new Date(u.lockUntil)>new Date())throw Error('Account temporarily locked');if(hashPassword_(String(x.password||''),u.salt)!==u.passwordHash){let f=Number(u.failed||0)+1,patch={failed:f};if(f>=CFG.MAX_FAILS)patch.lockUntil=new Date(Date.now()+CFG.LOCK_MIN*60000).toISOString();update_(CFG.USERS,'userId',u.userId,patch);audit_(u.userId,'LOGIN_FAIL',{});throw Error('Invalid username or credentials')}update_(CFG.USERS,'userId',u.userId,{failed:0,lockUntil:'',lastLogin:now_()});let raw=Utilities.getUuid()+Utilities.getUuid(),token=hmac_(raw),sid=id_('AUTH');append_(CFG.SESSIONS,{sessionId:sid,userId:u.userId,tokenHash:hmac_(token),expires:new Date(Date.now()+CFG.SESSION_HOURS*3600000).toISOString(),revoked:false,createdAt:now_()});audit_(u.userId,'LOGIN_OK',{});return{token,user:safeUser_(u)}}
function requireSession_(token){if(!token)throw Error('Authentication required');let th=hmac_(token),s=rows_(CFG.SESSIONS).find(r=>r.tokenHash===th&&!String(r.revoked).match(/true/i)&&new Date(r.expires)>new Date());if(!s)throw Error('Session expired');let u=rows_(CFG.USERS).find(x=>x.userId===s.userId&&x.status==='ACTIVE');if(!u)throw Error('Account unavailable');return u}
function logout_(token){let th=hmac_(token),s=rows_(CFG.SESSIONS).find(r=>r.tokenHash===th);if(s)update_(CFG.SESSIONS,'sessionId',s.sessionId,{revoked:true});return{message:'Signed out'}}
function requestOtp_(x){let u=findUser_(x.username,x.email);if(u&&['INVITED','ACTIVE'].includes(u.status)){let recent=rows_(CFG.OTP).filter(o=>o.userId===u.userId&&new Date(o.createdAt)>new Date(Date.now()-60000));if(recent.length)throw Error('Please wait before requesting another OTP');let otp=String(Math.floor(100000+Math.random()*900000));append_(CFG.OTP,{otpId:id_('OTP'),userId:u.userId,purpose:x.purpose,otpHash:hmac_(otp),expires:new Date(Date.now()+CFG.OTP_MIN*60000).toISOString(),attempts:0,used:false,createdAt:now_()});MailApp.sendEmail({to:u.email,subject:'PTW LMS verification code',htmlBody:`<p>Your PTW LMS verification code is:</p><p style="font-size:28px;font-weight:bold">${otp}</p><p>It expires in ${CFG.OTP_MIN} minutes. If you did not request it, contact the administrator.</p>`});audit_(u.userId,'OTP_SENT',{purpose:x.purpose})}return{message:'If eligible, an OTP was sent.'}}
function verifyOtpSetPassword_(x){if(String(x.newPassword||'').length<10||!/[A-Za-z]/.test(x.newPassword)||!/[0-9]/.test(x.newPassword))throw Error('Password must be at least 10 characters with letters and numbers');let u=findUser_(x.username,x.email);if(!u)throw Error('Verification failed');let os=rows_(CFG.OTP).filter(o=>o.userId===u.userId&&o.purpose===x.purpose&&!String(o.used).match(/true/i)&&new Date(o.expires)>new Date()).sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt)));let o=os[0];if(!o||Number(o.attempts)>=5)throw Error('OTP invalid or expired');if(o.otpHash!==hmac_(x.otp)){update_(CFG.OTP,'otpId',o.otpId,{attempts:Number(o.attempts)+1});throw Error('OTP invalid or expired')}let salt=Utilities.getUuid();update_(CFG.USERS,'userId',u.userId,{salt,passwordHash:hashPassword_(x.newPassword,salt),status:'ACTIVE',failed:0,lockUntil:'',passwordChanged:now_()});update_(CFG.OTP,'otpId',o.otpId,{used:true});rows_(CFG.SESSIONS).filter(s=>s.userId===u.userId).forEach(s=>update_(CFG.SESSIONS,'sessionId',s.sessionId,{revoked:true}));audit_(u.userId,'PASSWORD_SET',{purpose:x.purpose});return{message:'Account updated'}}
function assigned_(user,sessionId){return rows_(CFG.PARTICIPANTS).find(p=>p.sessionId===sessionId&&p.userId===user.userId)}
function dashboard_(u){let ps=rows_(CFG.PARTICIPANTS).filter(p=>p.userId===u.userId),ts=rows_(CFG.TRAINING);let sessions=ps.map(p=>{let s=ts.find(t=>t.sessionId===p.sessionId)||{};return{sessionId:p.sessionId,courseTitle:s.courseTitle||'PTW Competency',date:s.date,status:s.status}});let done=rows_(CFG.PROGRESS).filter(p=>p.userId===u.userId).length;return{sessions,progress:Math.min(100,Math.round(done/10*100))}}
function joinSession_(u,x){let p=assigned_(u,x.sessionId),s=rows_(CFG.TRAINING).find(t=>t.sessionId===x.sessionId);if(!p||!s||s.status!=='OPEN'||hmac_(x.sessionCode)!==s.codeHash)throw Error('Session is not available');update_(CFG.PARTICIPANTS,'participantId',p.participantId,{joinedAt:now_()});audit_(u.userId,'TRAINING_JOIN',{sessionId:x.sessionId});return{session:{sessionId:s.sessionId,courseId:s.courseId}}}
function course_(){let r=rows_(CFG.COURSE);if(!r.length)throw Error('Course is not configured');return JSON.parse(r[0].json)}
function getCourse_(u,x){if(u.role==='PARTICIPANT'&&!assigned_(u,x.sessionId))throw Error('Not assigned');return{course:course_()}}
function completeModule_(u,x){append_(CFG.PROGRESS,{progressId:id_('PRG'),userId:u.userId,sessionId:x.sessionId,moduleId:x.moduleId,completedAt:now_()});audit_(u.userId,'MODULE_COMPLETE',x);return{message:'Saved'}}
function startAssessment_(u,x){if(u.role==='PARTICIPANT'&&!assigned_(u,x.sessionId))throw Error('Not assigned');let q=course_().questions.sort(()=>Math.random()-.5).slice(0,15).map(z=>({id:z.id,text:z.text.en,options:z.options.sort(()=>Math.random()-.5).map(o=>({key:o.key,text:o.text.en}))}));return{assessmentId:id_('ASM'),passMark:CFG.PASS_MARK,questions:q}}
function submitAssessment_(u,x){let bank=course_().questions,correct=0;x.answers.forEach(a=>{let q=bank.find(q=>q.id===a.questionId);if(q&&q.correct===a.answer)correct++});let score=Math.round(correct/x.answers.length*100),passed=score>=CFG.PASS_MARK;append_(CFG.ATTEMPTS,{assessmentId:x.assessmentId,userId:u.userId,sessionId:x.sessionId,score,passed,answersJson:JSON.stringify(x.answers),submittedAt:now_()});audit_(u.userId,'ASSESSMENT_SUBMIT',{score,passed});return{score,passed,message:passed?'Knowledge assessment passed. Continue to the practical assessment.':'Review the learning modules with the invigilator before another attempt.'}}
function getPractical_(u,x){return{practical:{scenario:'Replace a damaged non-process water line support in an operating utility area using hand tools and a portable drill. The area remains operational. Prepare a PTW that defines the exact scope, location, hazards, controls, PPE, supporting documents, Toolbox Talk points and authorization needs.'}}}
function savePractical_(u,x){let rec={practicalId:id_('PRA'),userId:u.userId,sessionId:x.sessionId,status:x.submit?'SUBMITTED':'DRAFT',dataJson:JSON.stringify(x.data),createdAt:now_()},url='';append_(CFG.PRACTICAL,rec);if(x.submit)url=createAssessmentPdf_(u,rec,x.data);audit_(u.userId,'PRACTICAL_SAVE',{status:rec.status});return{message:x.submit?'Practical submitted and PDF saved.':'Draft saved.',pdfUrl:url}}
function createAssessmentPdf_(u,rec,d){let folderId=prop_('ASSESSMENT_FOLDER_ID');if(!folderId)throw Error('ASSESSMENT_FOLDER_ID is not configured');let doc=DocumentApp.create(`PTW Practical ${rec.practicalId}`),b=doc.getBody();b.appendParagraph('PTW PRACTICAL ASSESSMENT').setHeading(DocumentApp.ParagraphHeading.HEADING1);b.appendParagraph(`Assessment ID: ${rec.practicalId}`);b.appendParagraph(`Learner: ${u.fullName} (${u.username})`);b.appendParagraph(`Session: ${rec.sessionId}`);b.appendParagraph(`Submitted: ${rec.createdAt}`);Object.keys(d).forEach(k=>{b.appendParagraph(k.replace(/([A-Z])/g,' $1').toUpperCase()).setHeading(DocumentApp.ParagraphHeading.HEADING2);b.appendParagraph(String(d[k]||''))});b.appendParagraph('INVIGILATOR ASSESSMENT').setHeading(DocumentApp.ParagraphHeading.HEADING1);b.appendParagraph('Result: Pending invigilator review');b.appendParagraph('Comments:');doc.saveAndClose();let f=DriveApp.getFileById(doc.getId()),pdf=f.getAs(MimeType.PDF).setName(`PTW_Practical_${rec.practicalId}.pdf`),pf=DriveApp.getFolderById(folderId).createFile(pdf);f.setTrashed(true);update_(CFG.PRACTICAL,'practicalId',rec.practicalId,{pdfFileId:pf.getId(),pdfUrl:pf.getUrl()});return pf.getUrl()}
function adminSummary_(u){admin_(u);return{users:rows_(CFG.USERS).length,sessions:rows_(CFG.TRAINING).length,completed:rows_(CFG.ATTEMPTS).filter(a=>String(a.passed).match(/true/i)).length}}
function adminCreateUser_(u,x){admin_(u);if(findUser_(x.username)||rows_(CFG.USERS).some(z=>norm_(z.email)===norm_(x.email)))throw Error('Username or email already exists');append_(CFG.USERS,{userId:id_('USR'),username:x.username,fullName:x.fullName,email:x.email,role:x.role,status:'INVITED',salt:'',passwordHash:'',failed:0,lockUntil:'',createdAt:now_()});audit_(u.userId,'USER_CREATE',{username:x.username,role:x.role});return{message:'Invited'}}
function admin_(u){if(!u||u.role!=='ADMIN')throw Error('Administrator access required')}
function audit_(uid,action,detail){append_(CFG.AUDIT,{auditId:id_('AUD'),userId:uid,action,detailJson:JSON.stringify(detail||{}),at:now_()})}
function setupLms(){const defs={LMS_USERS:['userId','username','fullName','email','role','status','salt','passwordHash','failed','lockUntil','lastLogin','passwordChanged','createdAt'],LMS_OTP:['otpId','userId','purpose','otpHash','expires','attempts','used','createdAt'],LMS_AUTH_SESSIONS:['sessionId','userId','tokenHash','expires','revoked','createdAt'],LMS_TRAINING_SESSIONS:['sessionId','courseId','courseTitle','date','invigilatorId','status','codeHash','createdAt'],LMS_PARTICIPANTS:['participantId','sessionId','userId','joinedAt','attendance','verifiedBy'],LMS_PROGRESS:['progressId','userId','sessionId','moduleId','completedAt'],LMS_ASSESSMENTS:['assessmentId','userId','sessionId','score','passed','answersJson','submittedAt'],LMS_PRACTICAL:['practicalId','userId','sessionId','status','dataJson','pdfFileId','pdfUrl','createdAt'],LMS_AUDIT:['auditId','userId','action','detailJson','at'],LMS_COURSE:['courseId','version','json']};let ss=SpreadsheetApp.getActive();PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID',ss.getId());if(!prop_('PEPPER'))PropertiesService.getScriptProperties().setProperty('PEPPER',Utilities.getUuid()+Utilities.getUuid());Object.entries(defs).forEach(([n,h])=>{let s=ss.getSheetByName(n)||ss.insertSheet(n);if(s.getLastRow()===0)s.appendRow(h);s.setFrozenRows(1)});let folder=DriveApp.createFolder('PTW LMS Assessments');PropertiesService.getScriptProperties().setProperty('ASSESSMENT_FOLDER_ID',folder.getId());seedCourse_();return 'LMS setup complete'}
function createFirstAdmin(){let username='admin',email=Session.getActiveUser().getEmail()||'CHANGE_ME@example.com';if(!findUser_(username))append_(CFG.USERS,{userId:id_('USR'),username,fullName:'LMS Administrator',email,role:'ADMIN',status:'INVITED',failed:0,createdAt:now_()});return `Admin invited: ${username} / ${email}. Correct the email in LMS_USERS before activation if needed.`}
function createTrainingSession(invigilatorUsername,participantUsernames){let inv=findUser_(invigilatorUsername),code=String(Math.floor(100000+Math.random()*900000)),sid=id_('TRN');append_(CFG.TRAINING,{sessionId:sid,courseId:'PTW-CORE-001',courseTitle:'Permit to Work Competency',date:Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy-MM-dd'),invigilatorId:inv?inv.userId:'',status:'OPEN',codeHash:hmac_(code),createdAt:now_()});(participantUsernames||[]).forEach(n=>{let u=findUser_(n);if(u)append_(CFG.PARTICIPANTS,{participantId:id_('PAR'),sessionId:sid,userId:u.userId,attendance:'PENDING'})});return `Session ${sid}; code ${code}`}
function seedCourse_(){let s=sh_(CFG.COURSE);if(s.getLastRow()>1)return;const course={title:'Permit to Work Competency',description:'Invigilated PTW training aligned to the approved company procedure. The procedure remains the governing document.',modules:[{id:'M1',title:{en:'Why PTW matters',id:'Mengapa PTW penting',ms:'Mengapa PTW penting'},html:{en:'<p>A permit is not permission to work without thinking. It is a formal communication and control process for hazardous work.</p><div class="callout stop"><strong>Stop work</strong> if scope, conditions, isolation or simultaneous operations change.</div>',id:'<p>Izin kerja adalah proses komunikasi dan pengendalian formal untuk pekerjaan berbahaya.</p><div class="callout stop"><strong>Hentikan pekerjaan</strong> jika ruang lingkup, kondisi, isolasi, atau pekerjaan bersamaan berubah.</div>',ms:'<p>Permit kerja ialah proses komunikasi dan kawalan formal bagi kerja berbahaya.</p>'}},{id:'M2',title:{en:'Roles and responsibilities',id:'Peran dan tanggung jawab',ms:'Peranan dan tanggungjawab'},html:{en:'<ul><li>Area Owner confirms plant and area conditions.</li><li>Job Coordinator defines and controls the work.</li><li>Permit Authorizer independently verifies authorization requirements.</li><li>The work party understands the scope, hazards and controls.</li></ul>',id:'<ul><li>Area Owner memastikan kondisi area.</li><li>Job Coordinator menetapkan serta mengendalikan pekerjaan.</li><li>Permit Authorizer memverifikasi persyaratan izin.</li></ul>',ms:'<ul><li>Pemilik Kawasan mengesahkan keadaan kawasan.</li><li>Penyelaras Kerja mengawal kerja.</li></ul>'}},{id:'M3',title:{en:'Plan and define the job',id:'Rencanakan dan definisikan pekerjaan',ms:'Rancang dan takrifkan kerja'},html:{en:'<p>Use an exact scope, exact location, equipment identity, start and finish time, work method and boundaries. Avoid vague descriptions.</p>',id:'<p>Gunakan ruang lingkup, lokasi, identitas peralatan, waktu, metode, dan batas pekerjaan yang tepat.</p>',ms:'<p>Gunakan skop, lokasi, identiti peralatan, masa dan kaedah yang tepat.</p>'}},{id:'M4',title:{en:'Hazards, controls and isolation',id:'Bahaya, pengendalian, dan isolasi',ms:'Bahaya, kawalan dan pengasingan'},html:{en:'<p>Identify task, process, area and SIMOPS hazards. Verify isolation and zero energy before starting where required.</p>',id:'<p>Identifikasi bahaya tugas, proses, area, dan SIMOPS. Verifikasi isolasi dan energi nol jika diperlukan.</p>',ms:'<p>Kenal pasti bahaya tugas, proses, kawasan dan SIMOPS.</p>'}},{id:'M5',title:{en:'Supporting certificates and checklists',id:'Sertifikat dan checklist pendukung',ms:'Sijil dan senarai semak sokongan'},html:{en:'<ul><li>Hot work</li><li>Confined space</li><li>Excavation</li><li>Electrical and high voltage</li><li>Lifting</li><li>Working at height</li></ul>',id:'<ul><li>Pekerjaan panas</li><li>Ruang terbatas</li><li>Penggalian</li><li>Listrik</li><li>Pengangkatan</li><li>Bekerja di ketinggian</li></ul>',ms:'<p>Pilih sijil dan senarai semak berdasarkan bahaya sebenar.</p>'}},{id:'M6',title:{en:'Authorization and site verification',id:'Otorisasi dan verifikasi lokasi',ms:'Kebenaran dan pengesahan tapak'},html:{en:'<p>Signatures confirm checks were performed. They are not administrative decoration. Verify the site and safeguards before issue.</p>',id:'<p>Tanda tangan menegaskan pemeriksaan telah dilakukan. Verifikasi lokasi dan pengendalian sebelum penerbitan.</p>',ms:'<p>Tandatangan mengesahkan pemeriksaan telah dilakukan.</p>'}},{id:'M7',title:{en:'Toolbox Talk and dynamic risk assessment',id:'Toolbox Talk dan penilaian risiko dinamis',ms:'Toolbox Talk dan penilaian risiko dinamik'},html:{en:'<p>Every person must understand the task, hazards, controls, emergency actions and stop-work expectations in a language they understand.</p>',id:'<p>Setiap orang harus memahami tugas, bahaya, pengendalian, tindakan darurat, dan kewajiban stop work.</p>',ms:'<p>Setiap orang mesti memahami tugas, bahaya, kawalan dan tindakan kecemasan.</p>'}},{id:'M8',title:{en:'Revalidation, suspension and closure',id:'Revalidasi, penangguhan, dan penutupan',ms:'Pengesahan semula, penggantungan dan penutupan'},html:{en:'<p>Revalidate only after checking that scope, people, conditions, isolation and SIMOPS remain acceptable. Close only after the worksite and equipment are left safe.</p>',id:'<p>Revalidasi hanya setelah memastikan ruang lingkup, personel, kondisi, isolasi, dan SIMOPS tetap aman.</p>',ms:'<p>Sahkan semula hanya selepas keadaan disemak.</p>'}},{id:'M9',title:{en:'Human factors and learning from incidents',id:'Faktor manusia dan pembelajaran insiden',ms:'Faktor manusia dan pembelajaran insiden'},html:{en:'<p>Challenge assumptions, avoid copying old permits, control time pressure, and confirm field reality. A good permit supports a good conversation.</p>',id:'<p>Tantang asumsi, jangan menyalin izin lama, kendalikan tekanan waktu, dan pastikan kondisi lapangan.</p>',ms:'<p>Cabaran andaian dan sahkan keadaan sebenar di lapangan.</p>'}},{id:'M10',title:{en:'Practical PTW preparation',id:'Praktik pembuatan PTW',ms:'Amali penyediaan PTW'},html:{en:'<p>Prepare a complete permit for a simple activity. The invigilator checks accuracy, control selection, communication and field understanding.</p>',id:'<p>Siapkan izin lengkap untuk aktivitas sederhana. Invigilator memeriksa ketepatan dan pemahaman.</p>',ms:'<p>Sediakan permit lengkap untuk aktiviti mudah.</p>'}}],questions:[
