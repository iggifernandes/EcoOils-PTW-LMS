{id:'Q9',text:{en:'What is required before work on isolated equipment?'},options:[{key:'A',text:{en:'Assume isolation is adequate'}},{key:'B',text:{en:'Verify isolation and zero energy as applicable'}},{key:'C',text:{en:'Only attach a label'}},{key:'D',text:{en:'Start with low-risk work'}}],correct:'B'},
