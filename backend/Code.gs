{id:'Q4',text:{en:'When is a Toolbox Talk effective?'},options:[{key:'A',text:{en:'When only the supervisor signs'}},{key:'B',text:{en:'When the team understands scope, hazards, controls and stop-work expectations'}},{key:'C',text:{en:'After the job'}},{key:'D',text:{en:'Only for hot work'}}],correct:'B'},
